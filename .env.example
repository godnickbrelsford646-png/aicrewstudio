# --- Core ---
AICREW_DB=aicrew.db
AICREW_PORT=8000
AICREW_MASTER_KEY=change-me-32-bytes-long-secret!!

# --- Provider mode ---
# mock | openai
AICREW_LLM_PROVIDER=mock
# mock | flux | dalle
AICREW_IMAGE_PROVIDER=mock
# mock | tavily | serper
AICREW_SEARCH_PROVIDER=mock

# --- Real provider keys (used only when provider != mock) ---
OPENAI_API_KEY=
TAVILY_API_KEY=
FLUX_API_KEY=

# --- Channel credentials live in DB (encrypted with MASTER_KEY).
