# --- Core ---
AICREW_DB=aicrew.db
AICREW_PORT=8000
AICREW_MASTER_KEY=change-me-32-bytes-long-secret!!

# --- Provider mode ---
# Текстовые модели:
#   mock   — оффлайн-заглушка (без API).
#   openai — реальные вызовы. Поддерживает и OpenAI, и 302.ai шлюз
#            (роутинг по префиксу модели: openai:gpt-4o vs 302ai:gpt-4o).
AICREW_LLM_PROVIDER=openai

# Картинки:
#   mock   — оффлайн-заглушка.
#   302ai  — генерация через 302.ai (Wan 2.7, Flux и т.д.).
#   openai — DALL-E 3 / GPT-Image-1.
AICREW_IMAGE_PROVIDER=302ai

# Веб-поиск:
#   mock              — оффлайн-заглушка (по умолчанию).
#   openai_responses  — ходит через OpenAI Responses API + встроенный
#                       web_search tool. Использует OPENAI_API_KEY.
#                       Включает живой веб-поиск для ролей, у которых в
#                       tools_enabled есть "web_search": topic_generator,
#                       topic_validator, researcher, research_validator.
#                       Работает только когда модель агента openai:* —
#                       302.ai шлюз /responses не поддерживает и адаптер
#                       молча откатится на chat/completions.
AICREW_SEARCH_PROVIDER=mock

# --- API-ключи ---
OPENAI_API_KEY=
AI302_API_KEY=
TAVILY_API_KEY=
