# --- Core ---
AICREW_DB=aicrew.db
AICREW_PORT=8000
AICREW_MASTER_KEY=change-me-32-bytes-long-secret!!

# --- Provider mode ---
# Текстовые модели:
#   mock   — оффлайн-заглушка (без API).
#   openai — реальные вызовы. Поддерживает и OpenAI, и 302.ai шлюз
#            (роутинг по префиксу модели: openai:gpt-4o vs 302ai:gpt-4o).
AICREW_LLM_PROVIDER=openai

# Картинки:
#   mock   — оффлайн-заглушка.
#   302ai  — генерация через 302.ai. Поддерживаются ОБЕ ветки моделей:
#            * Wan 2.6 / 2.7 (async DashScope API):
#                302ai:wan2.7-image   ← дефолт seed.py
#                302ai:wan2.6-image
#              Эндпоинт /aliyun/api/v1/services/aigc/image-generation/generation
#              + polling /aliyun/api/v1/tasks/{task_id}. Стоимость по 302.ai
#              ~0.03 PTC / картинка. Реализовано в aicrew/tools/image_gen.py.
#            * Wan 2.1 legacy (async, формат input.prompt):
#                302ai:wanx-v1
#              Эндпоинт /aliyun/api/v1/services/aigc/text2image/image-synthesis.
#            * Синхронные модели через OpenAI-compat /v1/images/generations:
#                302ai:flux-1.1-pro
#                302ai:dall-e-3
#                302ai:gpt-image-1
#   openai — DALL-E 3 / GPT-Image-1 напрямую через OpenAI API.
AICREW_IMAGE_PROVIDER=302ai

# Веб-поиск:
#   mock   — оффлайн-заглушка (по умолчанию, без сети).
#   tavily — реальный веб-поиск через Tavily (https://tavily.com).
#            Включается ТОЧЕЧНО на агента: для каждой роли в её params
#            задан "search_query_template". Пустой шаблон = поиск выключен.
#            По умолчанию поиск включён только у topic_generator (1 раз/прогон)
#            и researcher (1 раз/тему). Кэш 24 часа в таблице search_cache,
#            так что RU и EN исследователи одной темы делят один Tavily-вызов.
AICREW_SEARCH_PROVIDER=tavily

# --- API-ключи ---
OPENAI_API_KEY=
AI302_API_KEY=
TAVILY_API_KEY=

# --- Public base URL (нужно для видео-генерации) ---
# 302.ai при image-to-video подкачивает исходный кадр по HTTPS — поэтому ему
# нужен абсолютный URL, а не наш локальный /media/x.png. Указывайте схему:
#   AICREW_PUBLIC_BASE_URL=https://mepoststream.site
# Если не задано — Wan i2v упадёт с ошибкой "image not reachable" и в /media/
# появится vclip_<hash>.error.txt с подсказкой. Картинки и текст работают и
# без этой переменной.
AICREW_PUBLIC_BASE_URL=

# --- Tavily-бюджет (опционально) ---
# Жёсткий лимит на число НОВЫХ запросов в Tavily за UTC-сутки. Когда счётчик
# исчерпан, web_search() возвращает [] и агенты работают без свежего веб-контекста.
# 0 или пусто = без лимита (только сам Tavily-аккаунт ограничивает).
# Tavily free tier даёт 1000 запросов/мес; при 1 пайплайне в день и кэше 24ч
# реально уходит ~7-13 запросов в день, лимит можно ставить с запасом 30-50.
TAVILY_DAILY_BUDGET=
