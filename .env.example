# --- Core ---
AICREW_DB=aicrew.db
AICREW_PORT=8000
AICREW_MASTER_KEY=change-me-32-bytes-long-secret!!

# --- Provider mode ---
# Текстовые модели:
#   mock   — оффлайн-заглушка (без API).
#   openai — реальные вызовы. Поддерживает и OpenAI, и 302.ai шлюз
#            (роутинг по префиксу модели: openai:gpt-4o vs 302ai:gpt-4o).
AICREW_LLM_PROVIDER=openai

# Картинки:
#   mock   — оффлайн-заглушка.
#   302ai  — генерация через 302.ai (синхронные модели: flux, dall-e, gpt-image-1).
#            ВАЖНО: Wan 2.x — асинхронный API (submit + poll task_id),
#            который наш текущий синхронный путь не поддерживает.
#            Если поставить image_model=302ai:wan2.7-image, картинки
#            упадут в красный плейсхолдер с надписью "ERR" и рядом
#            появится sidecar-файл .error.txt с причиной.
#            Дефолтная модель в seed.py — openai:gpt-image-1 (синхронная).
#            Альтернативы, которые точно работают:
#              openai:gpt-image-1     (новейшая, лучшая, ~$0.04/img)
#              openai:dall-e-3        (старее, ~$0.04-$0.08/img, до 1024x1024)
#              302ai:flux-1.1-pro     (Black Forest Labs, синхронно)
#   openai — DALL-E 3 / GPT-Image-1 напрямую через OpenAI.
AICREW_IMAGE_PROVIDER=302ai

# Веб-поиск:
#   mock   — оффлайн-заглушка (по умолчанию, без сети).
#   tavily — реальный веб-поиск через Tavily (https://tavily.com).
#            Включается ТОЧЕЧНО на агента: для каждой роли в её params
#            задан "search_query_template". Пустой шаблон = поиск выключен.
#            По умолчанию поиск включён только у topic_generator (1 раз/прогон)
#            и researcher (1 раз/тему). Кэш 24 часа в таблице search_cache,
#            так что RU и EN исследователи одной темы делят один Tavily-вызов.
AICREW_SEARCH_PROVIDER=tavily

# --- API-ключи ---
OPENAI_API_KEY=
AI302_API_KEY=
TAVILY_API_KEY=

# --- Tavily-бюджет (опционально) ---
# Жёсткий лимит на число НОВЫХ запросов в Tavily за UTC-сутки. Когда счётчик
# исчерпан, web_search() возвращает [] и агенты работают без свежего веб-контекста.
# 0 или пусто = без лимита (только сам Tavily-аккаунт ограничивает).
# Tavily free tier даёт 1000 запросов/мес; при 1 пайплайне в день и кэше 24ч
# реально уходит ~7-13 запросов в день, лимит можно ставить с запасом 30-50.
TAVILY_DAILY_BUDGET=
